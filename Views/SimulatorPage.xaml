<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="EcoBalanceLedger.Views.SimulatorPage"
             BackgroundColor="#0f172a"
             Title="Simulador ROI">

    <ScrollView Padding="16">
        <VerticalStackLayout Spacing="16">
            <Label Text="SIMULAÇÃO ESTRATÉGICA" FontSize="11" TextColor="#0ea5e9" FontAttributes="Bold" CharacterSpacing="1.5" />
            <Label Text="Calculadora de Sensibilidade" FontSize="24" TextColor="#f8fafc" FontAttributes="Bold" />
            <Label Text="Preveja o impacto de variações técnicas (ΔB) na produção bruta e no ROI sustentável."
                   FontSize="13" TextColor="#9ca3af" />

            <!-- Card de Parâmetros -->
            <Border Stroke="#1e293b" BackgroundColor="#1e293b" StrokeShape="RoundRectangle 12" Padding="16">
                <VerticalStackLayout Spacing="14">
                    <!-- Eficiência de Hardware -->
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="Eficiência de Hardware" TextColor="#f8fafc" FontSize="13"/>
                        <Label x:Name="LblHwVal" Grid.Column="1" Text="10%" TextColor="#0ea5e9" FontAttributes="Bold"/>
                    </Grid>
                    <Slider x:Name="SldHardware" Minimum="0" Maximum="50" Value="10"
                            MinimumTrackColor="#0ea5e9" MaximumTrackColor="#334155" ThumbColor="#10b981"
                            ValueChanged="OnParamChanged" />

                    <!-- Economia de Energia -->
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="Economia de Energia" TextColor="#f8fafc" FontSize="13"/>
                        <Label x:Name="LblEnergiaVal" Grid.Column="1" Text="15%" TextColor="#0ea5e9" FontAttributes="Bold"/>
                    </Grid>
                    <Slider x:Name="SldEnergia" Minimum="0" Maximum="40" Value="15"
                            MinimumTrackColor="#0ea5e9" MaximumTrackColor="#334155" ThumbColor="#10b981"
                            ValueChanged="OnParamChanged" />

                    <!-- Automação de Processos -->
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="Automação de Processos" TextColor="#f8fafc" FontSize="13"/>
                        <Label x:Name="LblAutoVal" Grid.Column="1" Text="20%" TextColor="#0ea5e9" FontAttributes="Bold"/>
                    </Grid>
                    <Slider x:Name="SldAutomacao" Minimum="0" Maximum="60" Value="20"
                            MinimumTrackColor="#0ea5e9" MaximumTrackColor="#334155" ThumbColor="#10b981"
                            ValueChanged="OnParamChanged" />

                    <!-- Investimento Inicial -->
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="Investimento Inicial" TextColor="#f8fafc" FontSize="13"/>
                        <Label x:Name="LblInvestVal" Grid.Column="1" Text="R$ 500.000" TextColor="#10b981" FontAttributes="Bold"/>
                    </Grid>
                    <Slider x:Name="SldInvestimento" Minimum="100000" Maximum="5000000" Value="500000"
                            MinimumTrackColor="#10b981" MaximumTrackColor="#334155" ThumbColor="#0ea5e9"
                            ValueChanged="OnParamChanged" />

                    <Label Text="Fórmula: ΔX = (I − C − ΔB)⁻¹ · d − X₀" TextColor="#6ee7b7" FontSize="12" FontFamily="Monospace" Margin="0,4,0,0"/>
                </VerticalStackLayout>
            </Border>

            <!-- Card de Resultados Projetados -->
            <Border Stroke="#10b981" BackgroundColor="#1e293b" StrokeShape="RoundRectangle 12" Padding="16">
                <VerticalStackLayout Spacing="12">
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                        <Border BackgroundColor="#0f172a" StrokeShape="RoundRectangle 8" Padding="12">
                            <VerticalStackLayout HorizontalOptions="Center">
                                <Label x:Name="LblRoi" Text="22.1%" TextColor="#10b981" FontSize="26" FontAttributes="Bold" HorizontalTextAlignment="Center"/>
                                <Label Text="ROI Estimado" TextColor="#9ca3af" FontSize="11" HorizontalTextAlignment="Center"/>
                            </VerticalStackLayout>
                        </Border>
                        <Border Grid.Column="1" BackgroundColor="#0f172a" StrokeShape="RoundRectangle 8" Padding="12">
                            <VerticalStackLayout HorizontalOptions="Center">
                                <Label x:Name="LblPayback" Text="18" TextColor="#0ea5e9" FontSize="26" FontAttributes="Bold" HorizontalTextAlignment="Center"/>
                                <Label Text="Payback (meses)" TextColor="#9ca3af" FontSize="11" HorizontalTextAlignment="Center"/>
                            </VerticalStackLayout>
                        </Border>
                    </Grid>

                    <Grid ColumnDefinitions="*,Auto" Margin="0,4">
                        <Label Text="Variação Produção (ΔX):" TextColor="#9ca3af" FontSize="13"/>
                        <Label x:Name="LblDeltaX" Grid.Column="1" Text="+14.2%" TextColor="#10b981" FontAttributes="Bold"/>
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="Economia Anual Projetada:" TextColor="#9ca3af" FontSize="13"/>
                        <Label x:Name="LblEconomia" Grid.Column="1" Text="R$ 125.000" TextColor="#10b981" FontAttributes="Bold"/>
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="Redução Estimada de CO₂:" TextColor="#9ca3af" FontSize="13"/>
                        <Label x:Name="LblCo2Reducao" Grid.Column="1" Text="-12.5%" TextColor="#10b981" FontAttributes="Bold"/>
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <Button Text="📄 Exportar Proposta para Diretoria" Clicked="OnExportClicked"
                    BackgroundColor="#059669" TextColor="White" FontAttributes="Bold" CornerRadius="10" HeightRequest="48"/>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
